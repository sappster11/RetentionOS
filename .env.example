# RetentionOS environment — copy to .env.local and fill in. NEVER commit real values.

# --- Supabase (owned data plane) ---
# From your Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS — used by MCP servers / sync jobs. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Direct Postgres connection (for migrations / analytics jobs)
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# --- AI providers (intelligence plane) ---
# Both are set so provider-agnosticism is real from day one (Phase 0 acceptance).
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...

# --- Later phases (leave blank until needed) ---
# Phase 3 — client data (per-client creds usually stored in DB/Vault, these are optional defaults)
# SHOPIFY_API_VERSION=2024-10
# KLAVIYO_API_REVISION=2024-10-15
# Phase 4 — delivery
# RESEND_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
