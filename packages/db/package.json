{
  "name": "@retentionos/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Owned data plane: Postgres migrations, generated types, and the shared data-access layer.",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "migrate": "node scripts/migrate.mjs",
    "seed": "tsx scripts/seed.ts",
    "seed:engine": "tsx scripts/seed-engine.ts",
    "seed:salescrm": "tsx scripts/seed-salescrm.ts",
    "seed:clienthub": "tsx scripts/seed-clienthub.ts",
    "rename:org": "tsx scripts/rename-org.ts",
    "seed:commerce": "tsx scripts/seed-commerce.ts",
    "seed:pm": "tsx scripts/seed-pm.ts",
    "seed:content": "tsx scripts/seed-content.ts",
    "ingest:context": "tsx scripts/ingest-context.ts",
    "analytics": "tsx scripts/compute-analytics.ts",
    "reporting": "tsx scripts/compute-reporting.ts",
    "typecheck": "tsc --noEmit",
    "gen-types": "supabase gen types typescript --linked > src/types.gen.ts"
  },
  "dependencies": {
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@retentionos/engine": "workspace:*",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2"
  }
}
