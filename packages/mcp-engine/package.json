  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "embedded-postgres": "18.4.0-beta.17",
    "tsx": "^4.19.2",
    "typescript": "^5.9.2",
    "vitest": "^3.0.0"
  }
}
