{
  "name": "@retentionos/mcp-engine",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Generic engine MCP server — the full meta-schema surface (tables/fields/records/views/revisions) as tools for any agent. Same service layer as the UI (agent-parity law).",
